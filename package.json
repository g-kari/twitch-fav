{
  "name": "twitch-fav",
  "version": "1.0.1",
  "description": "Twitch Favorites - Reorder and favorite Twitch streamers in the sidebar",
  "main": "dist/content.js",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "package": "npm run check && node scripts/package.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --module commonjs --outDir .test-build --sourceMap false && node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:browser": "npm run build && node scripts/browser-test.cjs"
  },
  "author": "g-kari",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.246",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.54.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.2.2",
    "webpack": "^5.106.1",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
